# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# SQLite databases (runtime generated)
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
database/*.db
database/*.sqlite

# Allow gitkeep files
!database/.gitkeep
!screenshots/.gitkeep

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary and test files
tests/*.db
*.log
scratch/
